# Supabase — copy from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — required for invite emails (Settings > API > service_role)
# NEVER expose this in the browser — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL — used for invite redirect links (set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Invite code — required to self-register (server-side only, not exposed to browser)
INVITE_CODE=BREF26

# Anthropic — required for the AI chat assistant (server-side only)
ANTHROPIC_API_KEY=sk-ant-your-key-here
